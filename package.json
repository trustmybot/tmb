{
  "name": "tmb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:local": "bun scripts/build.ts --local",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:links": "bun tests/lint/links.ts",
    "test:install": "sh tests/install/smoke.sh",
    "test:install:update": "bun tests/install/update.ts",
    "test:agent": "sh tests/agent-run/run.sh",
    "test:chain": "sh tests/agent-chain/run.sh",
    "test:chain:feature": "sh tests/agent-chain/feature.sh",
    "test:worker": "sh tests/agent-run/worker.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.2"
  }
}
